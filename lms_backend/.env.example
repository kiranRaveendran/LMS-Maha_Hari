# Copy this file to .env and fill in your own values.
# .env itself is gitignored and never committed — this file (.env.example)
# is the one that gets committed, so anyone cloning the repo knows which
# variables they need to set.

# Get these from dashboard.razorpay.com > Settings > API Keys, with
# "Test Mode" toggled on. See chat history for step-by-step instructions.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET_HERE
